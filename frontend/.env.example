# ============================================================
# Frontend environment variables (copy to .env)
# ============================================================

# Google OAuth — powers the "Continue with Google" button.
# 1. Create a "Web application" OAuth Client ID at:
#      https://console.cloud.google.com/apis/credentials
# 2. Add http://localhost:5173 to "Authorized JavaScript origins".
# 3. Paste the Client ID here (e.g. xxxxx.apps.googleusercontent.com).
#
# Leave empty to use the built-in demo Google login (dev only).
VITE_GOOGLE_CLIENT_ID=
