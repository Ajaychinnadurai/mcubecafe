# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default, switch to PostgreSQL in production)
# DATABASE_URL=postgres://user:password@localhost:5432/mcubes_cafe

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# UPI
UPI_ID=cafe-upi-id@upi  # [TODO: Replace with actual UPI ID]
UPI_PAYEE_NAME=Mcubes Cafe

# WhatsApp Business API
WHATSAPP_API_TOKEN=your_whatsapp_api_token  # [TODO: WhatsApp Business API credentials required]
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google OAuth — must match frontend VITE_GOOGLE_CLIENT_ID.
# When set, /api/auth/google/ verifies the Google ID token server-side.
# When empty (dev mode), the endpoint accepts the payload directly.
GOOGLE_CLIENT_ID=
